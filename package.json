{
  "name": "github-cards",
  "version": "1.0.0",
  "description": "Dynamically generate stats for your GitHub readme",
  "keywords": [
    "github-cards",
    "github-readme-stats",
    "readme-stats",
    "cards",
    "card-generator"
  ],
  "main": "src/index.js",
  "type": "module",
  "homepage": "https://github.com/NATroutter/github-cards",
  "bugs": {
    "url": "https://github.com/NATroutter/github-cards/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NATroutter/github-cards.git"
  },
  "scripts": {
    "dev": "node --watch express.js",
    "start": "node express.js",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint --error-on-warnings",
    "check": "biome check --write"
  },
  "author": "Anurag Hazra, NATroutter",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^18.0.3",
    "emoji-name-map": "^2.0.3",
    "express": "^5.2.1",
    "github-username-regex": "^1.0.0",
    "word-wrap": "^1.2.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0"
}
